// Restaurant OS — database schema
// This is the FOUNDATION milestone: users, roles, authentication.
// Later milestones (roster, clock-in, payroll, reservations, tables) will
// add their own models in this file and create new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Access control ──────────────────────────────────────────────
// Role controls WHAT a user can do (their permissions).
enum Role {
  OWNER // full access to everything, including financials
  MANAGER // runs day-to-day: rosters, approvals, reservations
  KITCHEN // back of house — sees KDS, own roster, own timesheet
  FLOOR // front of house: bar + waitstaff — tables, reservations, own roster
}

// Position controls operational details like pay rate, shown alongside role.
// A FLOOR user can be either BAR or WAIT; KITCHEN users are KITCHEN.
enum Position {
  KITCHEN
  BAR
  WAIT
  MANAGEMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(FLOOR)
  position     Position @default(WAIT)
  phone        String?
  // Hourly base rate in cents (avoids floating-point money bugs).
  // Used later by the payroll module.
  hourlyRateCents Int     @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs AuditLog[]
  shifts    Shift[]
  timeEntries TimeEntry[]

  @@index([role])
  @@index([isActive])
}

// ── Roster ──────────────────────────────────────────────────────
// A scheduled shift for one staff member. Times are stored as full
// UTC datetimes; the frontend renders them in local time.
model Shift {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  // Where this shift is worked. Defaults from the user's position but can
  // be overridden (e.g. a waiter covering the bar for one shift).
  position  Position
  notes     String?
  // Draft shifts are only visible to managers. Publishing makes the whole
  // week visible to staff.
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]

  @@index([userId])
  @@index([startsAt])
}

// ── Clock in / out ──────────────────────────────────────────────
// One row per clock-in. clockOut is null until the staff member clocks
// out, so an open entry means "currently on shift". Photos are stored as
// file paths (local dev) — in production these point at object storage.
model TimeEntry {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // The rostered shift this clock-in is matched to, if one was scheduled.
  shift         Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId       String?
  clockIn       DateTime  @default(now())
  clockOut      DateTime?
  clockInPhoto  String // path/url to the photo taken at clock-in
  clockOutPhoto String?
  // Captured at clock-in by comparing to the matched shift's start time.
  // Positive = minutes late, negative = minutes early, null = no shift.
  lateByMinutes Int?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([clockIn])
  @@index([clockOut])
}

// Lightweight audit trail. Every privileged action (creating a user,
// approving a timesheet, editing payroll) gets a row here.
model AuditLog {
  id        String   @id @default(cuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String // e.g. "user.create", "user.deactivate"
  target    String? // id of the affected entity
  meta      Json? // any extra context
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}
