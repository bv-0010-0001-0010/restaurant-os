// Restaurant OS — database schema
// This is the FOUNDATION milestone: users, roles, authentication.
// Later milestones (roster, clock-in, payroll, reservations, tables) will
// add their own models in this file and create new migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Access control ──────────────────────────────────────────────
// Role controls WHAT a user can do (their permissions).
enum Role {
  OWNER // full access to everything, including financials
  MANAGER // runs day-to-day: rosters, approvals, reservations
  KITCHEN // back of house — sees KDS, own roster, own timesheet
  FLOOR // front of house: bar + waitstaff — tables, reservations, own roster
}

// Position controls operational details like pay rate, shown alongside role.
// A FLOOR user can be either BAR or WAIT; KITCHEN users are KITCHEN.
enum Position {
  KITCHEN
  BAR
  WAIT
  MANAGEMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(FLOOR)
  position     Position @default(WAIT)
  phone        String?
  // Hourly base rate in cents (avoids floating-point money bugs).
  // Used later by the payroll module.
  hourlyRateCents Int     @default(0)
  isActive        Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  auditLogs AuditLog[]
  shifts    Shift[]
  timeEntries TimeEntry[]
  payslips    Payslip[]

  @@index([role])
  @@index([isActive])
}

// ── Roster ──────────────────────────────────────────────────────
// A scheduled shift for one staff member. Times are stored as full
// UTC datetimes; the frontend renders them in local time.
model Shift {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  startsAt  DateTime
  endsAt    DateTime
  // Where this shift is worked. Defaults from the user's position but can
  // be overridden (e.g. a waiter covering the bar for one shift).
  position  Position
  notes     String?
  // Draft shifts are only visible to managers. Publishing makes the whole
  // week visible to staff.
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeEntries TimeEntry[]

  @@index([userId])
  @@index([startsAt])
}

// ── Clock in / out ──────────────────────────────────────────────
// One row per clock-in. clockOut is null until the staff member clocks
// out, so an open entry means "currently on shift". Photos are stored as
// file paths (local dev) — in production these point at object storage.
model TimeEntry {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  // The rostered shift this clock-in is matched to, if one was scheduled.
  shift         Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId       String?
  clockIn       DateTime  @default(now())
  clockOut      DateTime?
  clockInPhoto  String // path/url to the photo taken at clock-in
  clockOutPhoto String?
  // Captured at clock-in by comparing to the matched shift's start time.
  // Positive = minutes late, negative = minutes early, null = no shift.
  lateByMinutes Int?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([clockIn])
  @@index([clockOut])
}

// Lightweight audit trail. Every privileged action (creating a user,
// approving a timesheet, editing payroll) gets a row here.
model AuditLog {
  id        String   @id @default(cuid())
  actor     User     @relation(fields: [actorId], references: [id])
  actorId   String
  action    String // e.g. "user.create", "user.deactivate"
  target    String? // id of the affected entity
  meta      Json? // any extra context
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// ── Payroll ─────────────────────────────────────────────────────
// A pay run covers a date range and freezes a set of payslips so the
// numbers stay reproducible even if clock-ins are edited later.
//
// IMPORTANT: tax and super here use simplified flat rates (see payroll.ts).
// They are ESTIMATES, not compliant Australian payroll figures. Verify
// against the relevant Fair Work award before using for real payments.
model PayRun {
  id           String    @id @default(cuid())
  periodStart  DateTime
  periodEnd    DateTime
  // Flat rates captured at run time so historical runs don't change when
  // you later adjust the defaults.
  taxRatePct   Float
  superRatePct Float
  createdAt    DateTime  @default(now())

  payslips Payslip[]

  @@index([periodStart])
}

model Payslip {
  id             String  @id @default(cuid())
  payRun         PayRun  @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  payRunId       String
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // All money stored in cents to avoid floating-point errors.
  hoursWorked    Float
  hourlyRateCents Int
  grossCents     Int
  taxCents       Int
  superCents     Int
  netCents       Int

  @@index([payRunId])
  @@index([userId])
}

// ── Reservations ────────────────────────────────────────────────
enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// A guest is a person who books, kept separate from staff Users. One guest
// can have many reservations, which gives us their visit history.
model Guest {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  phone       String?
  email       String?
  // Allergies / dietary requirements, surfaced on every booking.
  dietaryNotes String?
  // Free-form notes ("regular", "prefers booth", VIP, etc.).
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reservations Reservation[]

  @@index([lastName])
  @@index([phone])
}

model Reservation {
  id        String            @id @default(cuid())
  guest     Guest             @relation(fields: [guestId], references: [id], onDelete: Cascade)
  guestId   String
  // When the party is due to arrive, and how many people.
  startsAt  DateTime
  partySize Int
  status    ReservationStatus @default(PENDING)
  // Per-booking notes (occasion, special requests).
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([startsAt])
  @@index([status])
  @@index([guestId])
}
