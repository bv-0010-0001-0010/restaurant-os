# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.

# Server
PORT=4000
NODE_ENV=development

# Database (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://restaurant:restaurant_dev_password@localhost:5432/restaurant_os?schema=public"

# Auth — change this to a long random string in production
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# Frontend origin allowed to call this API (CORS)
CLIENT_ORIGIN="http://localhost:5173"
